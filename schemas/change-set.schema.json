      },
      "allOf": [
        { "if": { "properties": { "relations": { "type": "array", "contains": { "const": "added" } } }, "required": ["relations"] }, "then": { "properties": { "relations": { "type": "array", "maxItems": 1 }, "original": { "type": "null" }, "modified": { "$ref": "#/$defs/outlineMappingSide" } } } },
        { "if": { "properties": { "relations": { "type": "array", "contains": { "const": "removed" } } }, "required": ["relations"] }, "then": { "properties": { "relations": { "type": "array", "maxItems": 1 }, "original": { "$ref": "#/$defs/outlineMappingSide" }, "modified": { "type": "null" } } } },
        { "if": { "properties": { "relations": { "type": "array", "contains": { "const": "unchanged" } } }, "required": ["relations"] }, "then": { "properties": { "relations": { "type": "array", "maxItems": 1 } } } },
        { "if": { "properties": { "relations": { "type": "array", "not": { "contains": { "enum": ["added", "removed"] } } } }, "required": ["relations"] }, "then": { "properties": { "original": { "$ref": "#/$defs/outlineMappingSide" }, "modified": { "$ref": "#/$defs/outlineMappingSide" } } } }
      ],

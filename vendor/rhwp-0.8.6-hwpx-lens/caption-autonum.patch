diff --git a/src/renderer/layout/tests.rs b/src/renderer/layout/tests.rs
index 68715431..2f0d1166 100644
--- a/src/renderer/layout/tests.rs
+++ b/src/renderer/layout/tests.rs
@@ -254,6 +254,52 @@ fn issue3216_page_auto_number_does_not_expand_manual_page_field_model_text() {
 }
 
+#[test]
+fn caption_auto_number_before_punctuation_uses_control_position() {
+    use crate::model::control::{AutoNumber, AutoNumberType};
+
+    fn assert_caption(number_type: AutoNumberType, prefix: &str) {
+        let text = format!("{prefix}2- . 설명");
+        let hyphen_byte = text.find("- ").unwrap();
+        let placeholder = text[..=hyphen_byte].chars().count();
+        let mut char_offsets = Vec::new();
+        let mut raw_offset = 0u32;
+        for (index, ch) in text.chars().enumerate() {
+            if index == placeholder {
+                raw_offset += 8;
+            }
+            char_offsets.push(raw_offset);
+            raw_offset += ch.len_utf16() as u32;
+        }
+        let para = Paragraph {
+            char_count: raw_offset + 1,
+            text: text.clone(),
+            char_offsets,
+            controls: vec![Control::AutoNumber(AutoNumber {
+                number_type,
+                format: 0,
+                assigned_number: 3,
+                number: 3,
+                ..Default::default()
+            })],
+            ..Default::default()
+        };
+        assert_eq!(para.control_text_positions(), vec![placeholder]);
+        let engine = LayoutEngine::with_default_dpi();
+        let mut composed = compose_paragraph(&para);
+        engine.apply_auto_numbers_to_composed(
+            &mut composed,
+            &para,
+            &mut AutoNumberCounter::new(),
+        );
+        let raw: String = composed.lines.iter().flat_map(|line| &line.runs)
+            .map(|run| run.text.as_str()).collect();
+        let display: String = composed.lines.iter().flat_map(|line| &line.runs)
+            .map(|run| run.display_text.as_deref().unwrap_or(&run.text)).collect();
+        assert_eq!(raw, text);
+        assert_eq!(display, format!("{prefix}2-3. 설명"));
+    }
+    assert_caption(AutoNumberType::Picture, "그림 ");
+    assert_caption(AutoNumberType::Table, "표 ");
+}
